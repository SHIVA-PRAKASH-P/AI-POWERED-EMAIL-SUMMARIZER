# ==============================================================================
# AI Email Summarizer Agent for Faculty — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit .env containing real API keys or credentials into source control.
# ==============================================================================

# Application Environment
APP_NAME="AI Email Summarizer Agent for Faculty"
APP_ENV=development                # Options: development, test, production
DEBUG=True                         # Set to False in production
PORT=8001
HOST=127.0.0.1
SECRET_KEY=dev-secret-key          # REQUIRED: Set a strong random secret in production (min 16 chars)

# Database
DATABASE_URL=sqlite:///./backend/app/database/email_agent.db

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# LLM Service Configuration
# ------------------------------------------------------------------------------
AI_MODE=mock                       # Options: "mock" (offline fallback) or "llm"
LLM_PROVIDER=openai                # Options: openai, gemini, anthropic
LLM_API_KEY=                       # e.g., sk-... (OpenAI) or AIza... (Gemini)
LLM_MODEL=gpt-4o-mini              # e.g., gpt-4o-mini, gemini-1.5-flash, claude-3-5-sonnet
LLM_BASE_URL=                      # Optional custom/compatible endpoint (Ollama/vLLM)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=30.0
LLM_FALLBACK_ON_ERROR=True

# ------------------------------------------------------------------------------
# Email Ingestion Provider Configuration
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=mock                # Options: "mock" or "gmail"
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=./backend/app/database/gmail_token.json

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Stage 19A — College Gmail Integration)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/email-provider/gmail/oauth/callback
COLLEGE_GMAIL_ACCOUNT=shivaprakashp.cs24@bitsathy.ac.in
